{
	"project_name": "juni",
	"out_dir": "out",
	"out_binary": "juni",
	"main_file": "src/main.c",
	"tests_dir": "tests",
	"tests_suffix": ".c",
	"tests_sub": "ZZ",
	"tests_include_macro": "BUILD_TESTING_INCLUDE",

	"compiler": "cc",

	"macros": {
		"BUILD_DEBUG": "false",
		"BUILD_RELEASE": "false",
		"BUILD_TESTING": "false",
		"BUILD_ASAN": "false"
	},

	"flags": [
		"-std=c23",
		"-fwhole-program",
		"-Wall",
		"-Wextra",
		"-Werror=vla",
		"-Wconversion",
		"-Wno-unused-function",
		"-Wno-unused-parameter"
	],

	"profile_lsp": {
		"flags": [ "-xc-header", "-ferror-limit=0" ],
		"macros": {
			"BUILD_DEBUG": "true",
			"BUILD_RELEASE": "true",
			"BUILD_TESTING": "true"
		}
	},

	"profile_release": {
		"flags": [ "-O2" ],
		"macros": {
			"BUILD_RELEASE": "true"
		}
	},

	"profile_asm": {
		"flags": [ "-masm=intel", "-fverbose-asm" ]
	},

	"profile_asan": {
		"flags": [ "-fsanitize=address" ],
		"macros": {
			"BUILD_ASAN": "true"
		}
	},

	"profile_debug": {
		"flags": [ "-g",  "-O0" ],
		"macros": {
			"BUILD_DEBUG": "true"
		}
	},

	"profile_testing": {
		"macros": {
			"BUILD_TESTING": "true"
		}
	}
}
